<*
 The `theme.auto` module: the light or dark theme on a schedule (time of day or the sun at a
 place), and the `matugen` methods that answer for the palette tool.

 Methods: `theme.auto.getState`, `setEnabled`, `setMode`, `setSchedule`, `setLocation`,
 `setUseIPLocation`, `trigger`, and `matugen.status`. Refused: `theme.auto.subscribe` (a streaming
 form), `matugen.queue` (the palette is generated by the external matugen tool, which Bleu does
 not run). Topic: `theme.auto` (`{"config":...,"isLight":...,"nextTransition":...}`).

 DMS computes this state and nothing else: its `thememode` manager never writes the desktop's
 colour scheme; the shell reads `isLight` and applies it. So this module has no Bleu backend and
 does not change the desktop either. The calculation is in `mod_theme_auto_calc.c3`.

 Source of every shape and rule: `core/internal/server/thememode/` (types.go, handlers.go,
 manager.go) and `core/internal/server/matugen_handler.go` at DMS master 8be08999.
 Deviations are listed in docs/DMSD.md. The defaults are dmsd's own: DMS's default settings
 were not read, and the schedule defaults are the constants of thememode/manager.go:14-20.
*>
module dmsd::theme_auto_mod;
import std::thread, std::time, bleu::error, bleu::ipc, dmsd::contract, dmsd::wire, dmsd::params, dmsd::replies, dmsd::theme_auto_calc;

const String[1] TOPICS       = { "theme.auto" };
const String[1] CAPABILITIES = { "theme.auto" };

// How often the ticker checks whether the next transition has come. A transition is at most a second late.
const Duration TICK_INTERVAL            =  (Duration)1_000_000;
// How long a schedule without a location waits before it asks again (thememode/manager.go:421).
const long NO_LOCATION_RECHECK_US       =  10 * 60 * theme_auto_calc::SEC_US;
// The next change of a disabled schedule is a day away (thememode/manager.go:184).
const long DAY_WITHOUT_SCHEDULE_US      =  24 * 3600 * theme_auto_calc::SEC_US;
// The defaults of thememode/manager.go:14-20.
const long DEFAULT_START_HOUR           =  18;
const long DEFAULT_END_HOUR             =  6;
// The default sun elevations (thememode/manager.go:19-20): twilight -6 degrees, daylight +3 degrees.
const double DEFAULT_ELEVATION_TWILIGHT = -6.0;
const double DEFAULT_ELEVATION_DAYLIGHT =  3.0;
// Reply text of the refused methods of this module (replies.c3).
const String NOT_SUPPORTED_SUBSCRIBE    =  "not supported: a streaming method cannot reply in this protocol; subscribe with services [\"theme.auto\"] instead";
const String NOT_SUPPORTED_QUEUE        =  "not supported: matugen palettes are generated by the matugen tool, which dmsd does not run";
const String NOT_SUPPORTED_IP           =  "not supported: IP geolocation is not available (Bleu has no geolocation service)";
const String INVALID_MODE               =  "invalid mode";
const String INVALID_TIME               =  "invalid schedule time";
const String MODE_TIME                  =  "time";
const String MODE_LOCATION              =  "location";
// The `matugen.status` reply: nothing is queued, because `matugen.queue` is refused.
const String MATUGEN_STATUS             =  "{\"pending\":false,\"running\":false,\"smartSupported\":false}";

// The refused methods of this module: each answers `not supported: <why>`.
const replies::Refusal[2] REFUSED = {
	{ .method = "theme.auto.subscribe", .text = NOT_SUPPORTED_SUBSCRIBE },
	{ .method = "matugen.queue", .text = NOT_SUPPORTED_QUEUE },
};

<*
 The schedule settings, as DMS's `thememode.Config` holds them. `has_location` is DMS's
 nil-pointer latitude and longitude; `location_mode` is DMS's mode string "location".
*>
struct ThemeSettings
{
	bool enabled;
	bool location_mode;
	long start_hour;
	long start_minute;
	long end_hour;
	long end_minute;
	bool has_location;
	double latitude;
	double longitude;
	bool use_ip_location;
	double elevation_twilight;
	double elevation_daylight;
}

<* What a reply shows: the settings, and the theme and its next change. *>
struct ThemeView
{
	ThemeSettings settings;
	bool light;
	long at;
}

<* The module's runtime state. Allocated in `start`, freed in `stop`. *>
struct ThemeAutoModule
{
	Mutex command; // serialises the setters: each reads the settings, changes them and updates
	Mutex mutex; // guards `view` and `stopping`
	ThemeView view;
	bool stopping;
	contract::StatePump state_pump;
	Thread ticker;
}

<* The settings a fresh daemon starts with. *>
fn ThemeSettings default_settings()
{
	return {
		.enabled = false,
		.location_mode = false,
		.start_hour = DEFAULT_START_HOUR,
		.start_minute = 0,
		.end_hour = DEFAULT_END_HOUR,
		.end_minute = 0,
		.elevation_twilight = DEFAULT_ELEVATION_TWILIGHT,
		.elevation_daylight = DEFAULT_ELEVATION_DAYLIGHT,
	};
}

<*
 The next change of the theme for `settings` at `now` (Unix microseconds), given the theme
 in force before it (DMS's `updateState` with `computeSchedule`, thememode/manager.go:263-278).
*>
fn ThemeView next_view(ThemeSettings settings, ThemeView previous, long now)
{
	if (!settings.enabled)
	{
		return { .settings = settings, .light = previous.light, .at = now + DAY_WITHOUT_SCHEDULE_US };
	}
	if (!settings.location_mode)
	{
		long current = theme_auto_calc::local_minute_of(now);
		theme_auto_calc::TimeChange change = theme_auto_calc::time_change(
			current,
			settings.start_hour * 60 + settings.start_minute,
			settings.end_hour * 60 + settings.end_minute
		);
		long at = theme_auto_calc::local_instant(theme_auto_calc::local_day_of(now) + change.days, change.minute);
		return { .settings = settings, .light = change.light, .at = at };
	}
	if (!settings.has_location)
	{
		return { .settings = settings, .light = previous.light, .at = now + NO_LOCATION_RECHECK_US };
	}
	theme_auto_calc::Transition change = theme_auto_calc::location_change(
		settings.latitude,
		settings.longitude,
		settings.elevation_twilight,
		settings.elevation_daylight,
		now
	);
	return { .settings = settings, .light = change.light, .at = change.at };
}

// Recompute the view at `now`. The caller holds the mutex.
fn void ThemeAutoModule.recompute(&self, long now)
{
	self.view = next_view(self.view.settings, self.view, now);
}

// A copy of the view, taken under the mutex.
fn ThemeView ThemeAutoModule.snapshot(&self)
{
	self.mutex.lock()!!;
	defer self.mutex.unlock();
	return self.view;
}

<*
 Change the settings and recompute at once, so the next reply shows the new theme. The
 change is announced on the topic.
*>
fn void ThemeAutoModule.update(&self, ThemeSettings settings)
{
	self.mutex.lock()!!;
	self.view.settings = settings;
	self.recompute(theme_auto_calc::now_us());
	self.mutex.unlock();
	self.state_pump.notify();
}

<* One DMS `thememode.State`: `{"config":{...},"isLight":...,"nextTransition":...}`. *>
fn String? render_view(Allocator allocator, ThemeView view)
{
	wire::Line line;
	line.begin(allocator);
	ThemeSettings s = view.settings;
	line.writer.begin_object()!;
	line.writer.key("config")!;
	line.writer.begin_object()!;
	wire::key_bool(&line.writer, "enabled", s.enabled)!;
	wire::key_string(&line.writer, "mode", s.location_mode ? MODE_LOCATION : MODE_TIME)!;
	wire::key_int(&line.writer, "startHour", s.start_hour)!;
	wire::key_int(&line.writer, "startMinute", s.start_minute)!;
	wire::key_int(&line.writer, "endHour", s.end_hour)!;
	wire::key_int(&line.writer, "endMinute", s.end_minute)!;
	if (s.has_location)
	{
		wire::key_double(&line.writer, "latitude", s.latitude)!;
		wire::key_double(&line.writer, "longitude", s.longitude)!;
	}
	wire::key_bool(&line.writer, "useIPLocation", s.use_ip_location)!;
	wire::key_double(&line.writer, "elevationTwilight", s.elevation_twilight)!;
	wire::key_double(&line.writer, "elevationDaylight", s.elevation_daylight)!;
	line.writer.end_object()!;
	wire::key_bool(&line.writer, "isLight", view.light)!;
	wire::key_time(&line.writer, "nextTransition", (Time)view.at)!;
	line.writer.end_object()!;
	return line.finish();
}

// The pump's encoder: the newest view, in temporary memory.
fn String? encode_state(void* context, Allocator allocator)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	return render_view(allocator, m.snapshot());
}

// `theme.auto.setSchedule`: four clock values, each checked as `ValidateSchedule` checks it (thememode/manager.go:453-458).
fn bool valid_clock(long hour, long minute) @inline => hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59;

fn void handle_get_state(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	@pool()
	{
		if (try line = render_view(tmem, m.snapshot()))
		{
			call.respond_raw(line);
		}
		else
		{
			call.respond_error(contract::failure_text("failed to read theme auto"));
		}
	};
}

fn void handle_set_enabled(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	@pool()
	{
		if (catch set_enabled(m, call)) call.respond_error(contract::failure_text("failed to set theme auto"));
	};
}

fn void? set_enabled(ThemeAutoModule* m, ipc::Call* call) @private
{
	m.command.lock()!!;
	defer m.command.unlock();
	bool enabled           = params::param_bool(call.params, "enabled")!;
	ThemeSettings settings = m.snapshot().settings;
	settings.enabled = enabled;
	m.update(settings);
	wire::respond_success(call, "theme auto enabled set")!;
}

fn void handle_set_mode(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	@pool()
	{
		if (catch set_mode(m, call)) call.respond_error(contract::failure_text("failed to set theme auto mode"));
	};
}

fn void? set_mode(ThemeAutoModule* m, ipc::Call* call) @private
{
	m.command.lock()!!;
	defer m.command.unlock();
	String mode = params::param_string(call.params, "mode")!;
	if (mode != MODE_TIME && mode != MODE_LOCATION)
	{
		return error::raise(error::INVALID_ARGUMENT, error::Domain.INTERNAL, 0, "%s", INVALID_MODE)~;
	}
	ThemeSettings settings = m.snapshot().settings;
	settings.location_mode = mode == MODE_LOCATION;
	m.update(settings);
	wire::respond_success(call, "theme auto mode set")!;
}

fn void handle_set_schedule(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	@pool()
	{
		if (catch set_schedule(m, call)) call.respond_error(INVALID_TIME);
	};
}

// Replies with the state, as DMS does (handlers.go:98).
fn void? set_schedule(ThemeAutoModule* m, ipc::Call* call) @private
{
	m.command.lock()!!;
	defer m.command.unlock();
	long start_hour   = params::param_int(call.params, "startHour")!;
	long start_minute = params::param_int(call.params, "startMinute")!;
	long end_hour     = params::param_int(call.params, "endHour")!;
	long end_minute   = params::param_int(call.params, "endMinute")!;
	if (!valid_clock(start_hour, start_minute) || !valid_clock(end_hour, end_minute))
	{
		return error::raise(error::INVALID_ARGUMENT, error::Domain.INTERNAL, 0, "%s", INVALID_TIME)~;
	}
	ThemeSettings settings = m.snapshot().settings;
	settings.start_hour = start_hour;
	settings.start_minute = start_minute;
	settings.end_hour = end_hour;
	settings.end_minute = end_minute;
	m.update(settings);
	call.respond_raw(render_view(tmem, m.snapshot())!);
}

fn void handle_set_location(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	@pool()
	{
		if (catch set_location(
			m,
			call
		)) call.respond_error(contract::failure_text("failed to set theme auto location"));
	};
}

fn void? set_location(ThemeAutoModule* m, ipc::Call* call) @private
{
	m.command.lock()!!;
	defer m.command.unlock();
	double latitude        = wire::required_double(call.params, "latitude")!;
	double longitude       = wire::required_double(call.params, "longitude")!;
	ThemeSettings settings = m.snapshot().settings;
	settings.has_location = true;
	settings.latitude = latitude;
	settings.longitude = longitude;
	settings.use_ip_location = false;
	m.update(settings);
	wire::respond_success(call, "theme auto location set")!;
}

fn void handle_set_use_ip_location(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	@pool()
	{
		if (catch set_use_ip_location(
			m,
			call
		)) call.respond_error(contract::failure_text("failed to set theme auto IP location"));
	};
}

// `use` true needs a geolocation service Bleu does not have; false only clears the flag, as DMS does.
fn void? set_use_ip_location(ThemeAutoModule* m, ipc::Call* call) @private
{
	m.command.lock()!!;
	defer m.command.unlock();
	bool use = params::param_bool(call.params, "use")!;
	if (use) return error::raise(error::UNSUPPORTED, error::Domain.INTERNAL, 0, "%s", NOT_SUPPORTED_IP)~;
	ThemeSettings settings = m.snapshot().settings;
	settings.use_ip_location = false;
	m.update(settings);
	wire::respond_success(call, "theme auto IP location set")!;
}

fn void handle_trigger(void* context, ipc::Call* call)
{
	ThemeAutoModule* m = (ThemeAutoModule*)context;
	m.update(m.snapshot().settings);
	@pool()
	{
		if (catch wire::respond_success(call, "theme auto update triggered"))
		{
			call.respond_error(contract::failure_text("failed to trigger theme auto"));
		}
	};
}

// `matugen.status` (matugen_handler.go:77-84): the three flags, as Go writes the map (keys sorted).
fn void handle_matugen_status(void* context, ipc::Call* call)
{
	call.respond_raw(MATUGEN_STATUS);
}

// Answers the refused methods (replies.c3).
fn void handle_refused(void* context, ipc::Call* call)
{
	replies::answer(REFUSED[..], call);
}

// The ticker: once a second, recompute the view if its next change has come, and publish it.
fn int ticker_main(void* arg) @private
{
	ThemeAutoModule* m = (ThemeAutoModule*)arg;
	while (true)
	{
		m.mutex.lock()!!;
		if (m.stopping)
		{
			m.mutex.unlock();
			return 0;
		}
		long now = theme_auto_calc::now_us();
		bool due = now >= m.view.at;
		if (due) m.recompute(now);
		m.mutex.unlock();
		if (due) m.state_pump.notify();
		thread::sleep(TICK_INTERVAL)!!;
	}
	return 0;
}

<* Start the module. Always succeeds: the calculation needs no backend. *>
fn bool start(contract::Context* context, contract::Module* self)
{
	ThemeAutoModule* m = alloc::new(context.allocator, ThemeAutoModule);
	m.command.init()!!;
	m.mutex.init()!!;
	m.view.settings = default_settings();
	m.recompute(theme_auto_calc::now_us());
	ipc::Topic* topic = context.server.register_topic("theme.auto")!!;
	context.server.register_method("theme.auto.getState", &handle_get_state, m)!!;
	context.server.register_method("theme.auto.setEnabled", &handle_set_enabled, m)!!;
	context.server.register_method("theme.auto.setMode", &handle_set_mode, m)!!;
	context.server.register_method("theme.auto.setSchedule", &handle_set_schedule, m)!!;
	context.server.register_method("theme.auto.setLocation", &handle_set_location, m)!!;
	context.server.register_method("theme.auto.setUseIPLocation", &handle_set_use_ip_location, m)!!;
	context.server.register_method("theme.auto.trigger", &handle_trigger, m)!!;
	context.server.register_method("matugen.status", &handle_matugen_status, m)!!;
	replies::register_all(context.server, REFUSED[..], &handle_refused)!!;
	m.state_pump.start("theme.auto", topic, &encode_state, m)!!;
	m.ticker.create(&ticker_main, m)!!;
	m.state_pump.notify();
	self.state = m;
	return true;
}

<* Stop the module: the ticker ends, the pump stops, and the state is freed. The server has stopped already. *>
fn void stop(contract::Context* context, contract::Module* self)
{
	ThemeAutoModule* m = (ThemeAutoModule*)self.state;
	m.mutex.lock()!!;
	m.stopping = true;
	m.mutex.unlock();
	m.ticker.join()!!;
	m.state_pump.stop();
	m.state_pump.free();
	m.mutex.destroy();
	m.command.destroy();
	alloc::free(context.allocator, m);
}

<* The module's descriptor for `main`. A global constant, so its slices point at static data. *>
const contract::Module DESCRIPTOR = {
	.name = "theme.auto",
	.start = &start,
	.stop = &stop,
	.topics = TOPICS[..],
	.capabilities = CAPABILITIES[..],
};

fn contract::Module descriptor() => DESCRIPTOR;