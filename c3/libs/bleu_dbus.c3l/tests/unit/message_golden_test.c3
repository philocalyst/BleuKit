// A METHOD_CALL Hello to the bus daemon, serial 1.
const HELLO = "6c 01 00 01 00 00 00 00 01 00 00 00 6d 00 00 00 01 01 6f 00 15 00 00 00 2f 6f 72 67 2f 66 72 65 65 64 65 73 6b 74 6f 70 2f 44 42 75 73 00 00 00 02 01 73 00 14 00 00 00 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00 00 00 00 03 01 73 00 05 00 00 00 48 65 6c 6c 6f 00 00 00 06 01 73 00 14 00 00 00 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00 00 00 00";

// The same Hello, big-endian (header integers swapped).
const HELLO_BIG_ENDIAN = "42 01 00 01 00 00 00 00 00 00 00 01 00 00 00 6d 01 01 6f 00 00 00 00 15 2f 6f 72 67 2f 66 72 65 65 64 65 73 6b 74 6f 70 2f 44 42 75 73 00 00 00 02 01 73 00 00 00 00 14 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00 00 00 00 03 01 73 00 00 00 00 05 48 65 6c 6c 6f 00 00 00 06 01 73 00 00 00 00 14 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00 00 00 00";

// A METHOD_CALL with one STRING argument, serial 2.
const GET_NAME_OWNER = "6c 01 00 01 19 00 00 00 02 00 00 00 7f 00 00 00 01 01 6f 00 15 00 00 00 2f 6f 72 67 2f 66 72 65 65 64 65 73 6b 74 6f 70 2f 44 42 75 73 00 00 00 02 01 73 00 14 00 00 00 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00 00 00 00 03 01 73 00 0c 00 00 00 47 65 74 4e 61 6d 65 4f 77 6e 65 72 00 00 00 00 06 01 73 00 14 00 00 00 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00 00 00 00 08 01 67 00 01 73 00 00 14 00 00 00 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 00";

// A SIGNAL with a STRING and an a{sv} argument, serial 3.
const SIGNAL = "6c 04 00 01 24 00 00 00 03 00 00 00 4c 00 00 00 01 01 6f 00 0a 00 00 00 2f 6f 72 67 2f 78 2f 4f 62 6a 00 00 00 00 00 00 02 01 73 00 0b 00 00 00 6f 72 67 2e 78 2e 49 66 61 63 65 00 00 00 00 00 03 01 73 00 07 00 00 00 43 68 61 6e 67 65 64 00 08 01 67 00 06 73 61 7b 73 76 7d 00 00 00 00 00 04 00 00 00 4e 61 6d 65 00 00 00 00 14 00 00 00 05 00 00 00 43 6f 75 6e 74 00 01 75 00 00 00 00 07 00 00 00";

// An ERROR reply to serial 2, with a string argument, serial 4.
const ERROR = "6c 03 00 01 13 00 00 00 04 00 00 00 57 00 00 00 04 01 73 00 28 00 00 00 6f 72 67 2e 66 72 65 65 64 65 73 6b 74 6f 70 2e 44 42 75 73 2e 45 72 72 6f 72 2e 55 6e 6b 6e 6f 77 6e 4d 65 74 68 6f 64 00 00 00 00 00 00 00 00 05 01 75 00 02 00 00 00 06 01 73 00 04 00 00 00 3a 31 2e 35 00 00 00 00 08 01 67 00 01 73 00 00 0e 00 00 00 6e 6f 20 73 75 63 68 20 6d 65 74 68 6f 64 00";

// A METHOD_RETURN to serial 2, with a STRING, serial 5.
const METHOD_RETURN = "6c 02 00 01 09 00 00 00 05 00 00 00 1f 00 00 00 05 01 75 00 02 00 00 00 06 01 73 00 04 00 00 00 3a 31 2e 35 00 00 00 00 08 01 67 00 01 73 00 00 04 00 00 00 3a 31 2e 39 00";

// A header whose PATH field is a STRING: invalid.
const PATH_IS_A_STRING = "6c 01 00 01 00 00 00 00 02 00 00 00 2e 00 00 00 01 01 73 00 15 00 00 00 2f 6f 72 67 2f 66 72 65 65 64 65 73 6b 74 6f 70 2f 44 42 75 73 00 00 00 03 01 73 00 05 00 00 00 48 65 6c 6c 6f 00 00 00";

fn String bytes_of(String hex_text) @inline => testing::from_hex(hex_text);

// The Hello, encoded by this library, equals dbus-next's bytes.
fn void encodes_hello_like_dbus_next() @test
{
	@pool()
	{
		Message* m = message::method_call(mem, "org.freedesktop.DBus", "/org/freedesktop/DBus",
			"org.freedesktop.DBus", "Hello")!!;
		m.serial = 1;
		DString out;
		out.init(tmem);
		m.encode(&out)!!;
		testing::expect_bytes(out.str_view(), HELLO);
		m.release();
	};
}

// A GetNameOwner call with a string argument, encoded from a body writer.
fn void encodes_a_call_with_arguments_like_dbus_next() @test
{
	@pool()
	{
		Message* m = message::method_call(mem, "org.freedesktop.DBus", "/org/freedesktop/DBus",
			"org.freedesktop.DBus", "GetNameOwner")!!;
		m.serial = 2;
		Writer* w = m.body_writer("s")!!;
		w.append_string("org.freedesktop.DBus")!!;
		DString out;
		out.init(tmem);
		m.encode(&out)!!;
		testing::expect_bytes(out.str_view(), GET_NAME_OWNER);
		m.release();
	};
}

// A signal with a dictionary argument, encoded from a body writer.
fn void encodes_a_signal_like_dbus_next() @test
{
	@pool()
	{
		Message* m = message::signal(mem, "/org/x/Obj", "org.x.Iface", "Changed")!!;
		m.serial = 3;
		Writer* w = m.body_writer("sa{sv}")!!;
		w.append_string("Name")!!;
		w.begin_array("a{sv}")!!;
		w.begin_dict_entry()!!;
		w.append_string("Count")!!;
		w.begin_variant("u")!!;
		w.append_u32(7)!!;
		w.end_variant()!!;
		w.end_dict_entry()!!;
		w.end_array()!!;
		DString out;
		out.init(tmem);
		m.encode(&out)!!;
		testing::expect_bytes(out.str_view(), SIGNAL);
		m.release();
	};
}

// An ERROR reply and a METHOD_RETURN, built from a call they answer.
fn void encodes_replies_like_dbus_next() @test
{
	@pool()
	{
		Message* call = message::method_call(mem, "", "/x", "a.b", "M")!!;
		call.serial = 2;
		call.sender = ":1.5";
		Message* err = message::error_reply(mem, call, "org.freedesktop.DBus.Error.UnknownMethod", "no such method")!!;
		err.serial = 4;
		DString out;
		out.init(tmem);
		err.encode(&out)!!;
		testing::expect_bytes(out.str_view(), ERROR);
		err.release();

		Message* ret = message::method_return(mem, call)!!;
		ret.serial = 5;
		Writer* w = ret.body_writer("s")!!;
		w.append_string(":1.9")!!;
		DString again;
		again.init(tmem);
		ret.encode(&again)!!;
		testing::expect_bytes(again.str_view(), METHOD_RETURN);
		ret.release();
		call.release();
	};
}

// Parsing the dbus-next bytes gives back the same header fields.
fn void parses_hello() @test
{
	@pool()
	{
		Message* m = message::parse(mem, bytes_of(HELLO))!!;
		assert(m.type == METHOD_CALL);
		assert(m.serial == 1);
		assert(m.flags == 0);
		assert(m.path == "/org/freedesktop/DBus");
		assert(m.interface_name == "org.freedesktop.DBus");
		assert(m.member == "Hello");
		assert(m.destination == "org.freedesktop.DBus");
		assert(m.signature.len == 0);
		assert(m.body.len == 0);
		m.release();
	};
}

// A big-endian message parses to the same fields as its little-endian twin.
fn void parses_big_endian_hello() @test
{
	@pool()
	{
		Message* m = message::parse(mem, bytes_of(HELLO_BIG_ENDIAN))!!;
		assert(m.big_endian);
		assert(m.serial == 1);
		assert(m.member == "Hello");
		m.release();
	};
}

// The body of a signal reads back as its signature says.
fn void parses_signal_body() @test
{
	@pool()
	{
		Message* m = message::parse(mem, bytes_of(SIGNAL))!!;
		assert(m.type == SIGNAL);
		assert(m.interface_name == "org.x.Iface");
		Reader r = m.reader()!!;
		assert(r.read_string()!! == "Name");
		Value dict = r.read_value(tmem)!!;
		assert(dict.dict_get("Count")!!.as_u32()!! == 7);
		r.finish()!!;
		m.release();
	};
}

// The error text and reply serial of an ERROR, and the reply of a METHOD_RETURN.
fn void parses_replies() @test
{
	@pool()
	{
		Message* err = message::parse(mem, bytes_of(ERROR))!!;
		assert(err.is_error());
		assert(err.reply_serial == 2);
		assert(err.error_name == "org.freedesktop.DBus.Error.UnknownMethod");
		assert(err.error_text()!! == "no such method");
		err.release();
		Message* ret = message::parse(mem, bytes_of(METHOD_RETURN))!!;
		assert(ret.type == METHOD_RETURN);
		assert(ret.destination == ":1.5");
		testing::@expect_fault(ret.error_text(), error::INVALID_STATE);
		ret.release();
	};
}

// The framing length of a message comes from its fixed header alone.
fn void frames_messages_from_their_prefix() @test
{
	assert((message::frame_length(bytes_of(HELLO)) ?? 0) == 128);
	assert((message::frame_length(bytes_of(SIGNAL)) ?? 0) == 132);
	assert((message::frame_length(bytes_of(HELLO_BIG_ENDIAN)) ?? 0) == 128);
}

// Malformed messages are refused with PROTOCOL.
fn void rejects_malformed_messages() @test
{
	@pool()
	{
		DString copy;
		copy.init(tmem);
		copy.append_bytes(bytes_of(HELLO));
		copy.set(8, 0);
		copy.set(9, 0);
		copy.set(10, 0);
		copy.set(11, 0);
		testing::@expect_fault(message::parse(tmem, copy.str_view()), error::PROTOCOL);
	};
	@pool()
	{
		DString copy;
		copy.init(tmem);
		copy.append_bytes(bytes_of(HELLO));
		copy.set(0, 'X');
		testing::@expect_fault(message::parse(tmem, copy.str_view()), error::PROTOCOL);
	};
	@pool()
	{
		DString copy;
		copy.init(tmem);
		copy.append_bytes(bytes_of(HELLO));
		copy.set(3, 2);
		testing::@expect_fault(message::parse(tmem, copy.str_view()), error::PROTOCOL);
	};
	@pool()
	{
		testing::@expect_fault(message::parse(tmem, bytes_of(PATH_IS_A_STRING)), error::PROTOCOL);
	};
	@pool()
	{
		DString copy;
		copy.init(tmem);
		copy.append_bytes(bytes_of(HELLO));
		copy.append_char(0);
		testing::@expect_fault(message::parse(tmem, copy.str_view()), error::PROTOCOL);
	};
	@pool()
	{
		// A body length of 2^27 makes the message exactly the 128 MiB limit: refused.
		DString copy;
		copy.init(tmem);
		copy.append_bytes(bytes_of(HELLO));
		copy.set(4, 0);
		copy.set(5, 0);
		copy.set(6, 0);
		copy.set(7, 0x08);
		testing::@expect_fault(message::frame_length(copy.str_view()), error::PROTOCOL);
	};
}
