		default:
			return error::raise(error::PROTOCOL, error::Domain.INTERNAL, 0, "opcode %d is not an event of zwlr_output_mode_v1", opcode)~;
	}
}

<*
 zwlr_output_configuration_v1 version 4.
 This object is used by the client to describe a full output configuration. First, the client
 needs to setup the output configuration. Each head can be either enabled (and configured) or
 disabled. It is a protocol error to send two enable_head or disable_head requests with the
 same head. It is a protocol error to omit a head in a configuration. Then, the client can
 apply or test the configuration. The compositor will then reply with a succeeded, failed or
 cancelled event. Finally the client should destroy the configuration object.
*>
const display::Interface ZWLR_OUTPUT_CONFIGURATION_V1 = { .name = "zwlr_output_configuration_v1", .version = 4, .dispatch = &zwlr_output_configuration_v1_dispatch };

<*
 Typed view of a zwlr_output_configuration_v1 object. The proxy is the first field, so a
 pointer to either type converts to the other.
*>
struct ZwlrOutputConfigurationV1
{
	display::Proxy base;
}

<*
 error (zwlr_output_configuration_v1.error).
*>
constset ZwlrOutputConfigurationV1Error : uint
{
	ALREADY_CONFIGURED_HEAD = 1,
	UNCONFIGURED_HEAD = 2,
	ALREADY_USED = 3,
}

<*
 Event zwlr_output_configuration_v1.succeeded: Sent after the compositor has successfully
 applied the changes or tested them. Upon receiving this event, the client should destroy
 this object. If the current configuration has changed, events to describe the changes will
 be sent followed by a wlr_output_manager.done event.
*>
alias ZwlrOutputConfigurationV1SucceededFn = fn void(void* context, ZwlrOutputConfigurationV1* target);

<*
 Event zwlr_output_configuration_v1.failed: Sent if the compositor rejects the changes or
 failed to apply them. The compositor should revert any changes made by the apply request
 that triggered this event. Upon receiving this event, the client should destroy this object.
*>
alias ZwlrOutputConfigurationV1FailedFn = fn void(void* context, ZwlrOutputConfigurationV1* target);

<*
 Event zwlr_output_configuration_v1.cancelled: Sent if the compositor cancels the
 configuration because the state of an output changed and the client has outdated information
 (e.g. after an output has been hotplugged). The client can create a new configuration with a
 newer serial and try again. Upon receiving this event, the client should destroy this
 object.
*>
alias ZwlrOutputConfigurationV1CancelledFn = fn void(void* context, ZwlrOutputConfigurationV1* target);

<*
 Event handlers of zwlr_output_configuration_v1. A null field ignores its event. Strings and
 arrays are valid only during the call, and a descriptor is owned by the handler, which must
 close it.
*>
struct ZwlrOutputConfigurationV1Listener
{
	ZwlrOutputConfigurationV1SucceededFn succeeded;
	ZwlrOutputConfigurationV1FailedFn failed;
	ZwlrOutputConfigurationV1CancelledFn cancelled;
}

<*
 Install the event handlers. The listener and the context must outlive the object.
*>
fn void ZwlrOutputConfigurationV1.set_listener(&self, ZwlrOutputConfigurationV1Listener* listener, void* context)
{
	self.base.listener = listener;
	self.base.context = context;
}


<*
 Enable a head. This request creates a head configuration object that can be used to change
 the head's properties.
*>
fn ZwlrOutputConfigurationHeadV1*? ZwlrOutputConfigurationV1.enable_head(&self, ZwlrOutputHeadV1* head)
{
	wire::Writer w;
	w.begin(self.base.id, 0);
	display::Proxy* created = self.base.conn.new_object(ZWLR_OUTPUT_CONFIGURATION_HEAD_V1, self.base.version)!;
	w.put_new_id(created.id)!;
	w.put_object(head.base.id)!;
	self.base.conn.send(&w)!;
	return (ZwlrOutputConfigurationHeadV1*)created;
}


<*
 Disable a head.
*>
fn void? ZwlrOutputConfigurationV1.disable_head(&self, ZwlrOutputHeadV1* head)
{
	wire::Writer w;
	w.begin(self.base.id, 1);
	w.put_object(head.base.id)!;
	self.base.conn.send(&w)!;
}


<*
 Apply the new output configuration. In case the configuration is successfully applied, there
 is no guarantee that the new output state matches completely the requested configuration.
 For instance, a compositor might round the scale if it doesn't support fractional scaling.
 After this request has been sent, the compositor must respond with an succeeded, failed or
 cancelled event. Sending a request that isn't the destructor is a protocol error.
*>
fn void? ZwlrOutputConfigurationV1.apply(&self)
{
	wire::Writer w;
	w.begin(self.base.id, 2);
	self.base.conn.send(&w)!;
}


<*
 Test the new output configuration. The configuration won't be applied, but will only be
 validated. Even if the compositor succeeds to test a configuration, applying it may fail.
 After this request has been sent, the compositor must respond with an succeeded, failed or
 cancelled event. Sending a request that isn't the destructor is a protocol error.
*>
fn void? ZwlrOutputConfigurationV1.test(&self)
{
	wire::Writer w;
	w.begin(self.base.id, 3);
	self.base.conn.send(&w)!;
}


<*
 Using this request a client can tell the compositor that it is not going to use the
 configuration object anymore. Any changes to the outputs that have not been applied will be
 discarded. This request also destroys wlr_output_configuration_head objects created via this
 object.
 Destructor: the object is retired locally once the request is sent.
*>
fn void? ZwlrOutputConfigurationV1.destroy(&self)
{
	wire::Writer w;
	w.begin(self.base.id, 4);
	self.base.conn.send(&w)!;
	self.base.conn.retire(&self.base);
}

fn void? zwlr_output_configuration_v1_dispatch(display::Display* conn, display::Proxy* proxy, ushort opcode, wire::Reader* args)
{
	ZwlrOutputConfigurationV1Listener* listener = (ZwlrOutputConfigurationV1Listener*)proxy.listener;
	switch (opcode)
	{
		case 0:
		{
			if (!proxy.zombie && listener != null && listener.succeeded != null)
			{
				listener.succeeded(proxy.context, (ZwlrOutputConfigurationV1*)proxy);
			}
			return;
		}
		case 1:
		{
			if (!proxy.zombie && listener != null && listener.failed != null)
			{
				listener.failed(proxy.context, (ZwlrOutputConfigurationV1*)proxy);
			}
			return;
		}
		case 2:
		{
			if (!proxy.zombie && listener != null && listener.cancelled != null)
			{
				listener.cancelled(proxy.context, (ZwlrOutputConfigurationV1*)proxy);
			}
			return;
		}
		default:
			return error::raise(error::PROTOCOL, error::Domain.INTERNAL, 0, "opcode %d is not an event of zwlr_output_configuration_v1", opcode)~;
	}
}

<*
 zwlr_output_configuration_head_v1 version 4.
 This object is used by the client to update a single head's configuration. It is a protocol
 error to set the same property twice.
*>
const display::Interface ZWLR_OUTPUT_CONFIGURATION_HEAD_V1 = { .name = "zwlr_output_configuration_head_v1", .version = 4, .dispatch = &zwlr_output_configuration_head_v1_dispatch };

<*
 Typed view of a zwlr_output_configuration_head_v1 object. The proxy is the first field, so a
 pointer to either type converts to the other.
*>
struct ZwlrOutputConfigurationHeadV1
{
	display::Proxy base;
}

<*
 error (zwlr_output_configuration_head_v1.error).
*>
constset ZwlrOutputConfigurationHeadV1Error : uint
{
	ALREADY_SET = 1,
	INVALID_MODE = 2,
	INVALID_CUSTOM_MODE = 3,
	INVALID_TRANSFORM = 4,
	INVALID_SCALE = 5,
	INVALID_ADAPTIVE_SYNC_STATE = 6,
}


<*
 This request sets the head's mode.
*>
fn void? ZwlrOutputConfigurationHeadV1.set_mode(&self, ZwlrOutputModeV1* mode)
{
	wire::Writer w;
	w.begin(self.base.id, 0);
	w.put_object(mode.base.id)!;
	self.base.conn.send(&w)!;
}


<*
 This request assigns a custom mode to the head. The size is given in physical hardware units
 of the output device. If set to zero, the refresh rate is unspecified. It is a protocol
 error to set both a mode and a custom mode.
*>
fn void? ZwlrOutputConfigurationHeadV1.set_custom_mode(&self, int width, int height, int refresh)
{
	wire::Writer w;
	w.begin(self.base.id, 1);
	w.put_int(width)!;
	w.put_int(height)!;
	w.put_int(refresh)!;
	self.base.conn.send(&w)!;
}


<*
 This request sets the head's position in the global compositor space.
*>
fn void? ZwlrOutputConfigurationHeadV1.set_position(&self, int x, int y)
{
	wire::Writer w;
	w.begin(self.base.id, 2);
	w.put_int(x)!;
	w.put_int(y)!;
	self.base.conn.send(&w)!;
}


<*
 This request sets the head's transform.
*>
fn void? ZwlrOutputConfigurationHeadV1.set_transform(&self, wayland::WlOutputTransform transform)
{
	wire::Writer w;
	w.begin(self.base.id, 3);
	w.put_int((int)(uint)transform)!;
	self.base.conn.send(&w)!;
}


<*
 This request sets the head's scale.
*>
fn void? ZwlrOutputConfigurationHeadV1.set_scale(&self, wire::Fixed scale)
{
	wire::Writer w;
	w.begin(self.base.id, 4);
	w.put_fixed(scale)!;
	self.base.conn.send(&w)!;
}


<*
 This request enables/disables adaptive sync. Adaptive sync is also known as Variable Refresh
 Rate or VRR.
 Available since version 4.
*>
fn void? ZwlrOutputConfigurationHeadV1.set_adaptive_sync(&self, ZwlrOutputHeadV1AdaptiveSyncState state)
{
	wire::Writer w;
	w.begin(self.base.id, 5);
	if (self.base.version < 4)
	{
		return error::raise(error::UNSUPPORTED, error::Domain.INTERNAL, 0, "zwlr_output_configuration_head_v1.set_adaptive_sync needs version 4, bound at version %d", self.base.version)~;
	}
	w.put_uint((uint)state)!;
	self.base.conn.send(&w)!;
}

<*
 Stop using this object locally. zwlr_output_configuration_head_v1 has no destructor request,
 so the server releases its id with wl_display.delete_id.
*>
fn void ZwlrOutputConfigurationHeadV1.destroy(&self)
{
	self.base.conn.retire(&self.base);
}

fn void? zwlr_output_configuration_head_v1_dispatch(display::Display* conn, display::Proxy* proxy, ushort opcode, wire::Reader* args)
{
	switch (opcode)
	{
		default:
			return error::raise(error::PROTOCOL, error::Domain.INTERNAL, 0, "opcode %d is not an event of zwlr_output_configuration_head_v1", opcode)~;
	}
}
