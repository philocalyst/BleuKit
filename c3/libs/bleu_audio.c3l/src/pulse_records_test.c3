// Decoders checked against replies a real PulseAudio 16.1 server sent
// (tests/fixtures/*.bin, recorded by tests/capture_fixtures.py), and state
// building from them. The card record is the exception: the daemon has no
// card, so its fixture is generated by tests/pulse_mock.py (marked synthetic).
module bleu::audio::pulse_records_test;
import bleu::audio, bleu::audio::pulse, bleu::error, std::core::mem::allocators;

// Payloads start with the command and tag words; the record decoders start after them.
fn void? skip_header(pulse::TagReader* r) @private
{
	r.u32()!;
	r.u32()!;
}

fn void real_server_info_decodes() @test
{
	char[] payload     = $embed("../tests/fixtures/server_info.bin");
	pulse::TagReader r = { .data = payload };
	skip_header(&r)!!;
	pulse::ServerInfo info = pulse::read_server_info(&r, 35)!!;
	assert(r.at_end());
	assert(info.server_name == "pulseaudio" && info.version == "16.1");
	assert(info.default_sink == "bleu_test" && info.default_source == "bleu_test.monitor");
}

fn void real_sink_decodes_its_properties() @test
{
	@pool()
	{
		char[] payload     = $embed("../tests/fixtures/sinks.bin");
		pulse::TagReader r = { .data = payload };
		skip_header(&r)!!;
		pulse::DeviceRecord sink = pulse::read_device(&r, 35, false, tmem)!!;
		assert(r.at_end());
		assert(sink.name == "bleu_test" && sink.description == "BleuTest");
		assert(sink.monitor_name == "bleu_test.monitor");
		assert(sink.volume.count == 2);
		assert(pulse::find_property(sink.props, "device.class") == "abstract");
		assert(pulse::find_property(sink.props, "device.description") == "BleuTest");
	};
}

fn void real_monitor_source_is_a_monitor() @test
{
	@pool()
	{
		char[] payload     = $embed("../tests/fixtures/sources.bin");
		pulse::TagReader r = { .data = payload };
		skip_header(&r)!!;
		pulse::DeviceRecord source = pulse::read_device(&r, 35, true, tmem)!!;
		assert(r.at_end());
		assert(source.name == "bleu_test.monitor");
		assert(source.monitor_index != pulse::NO_INDEX);
		assert(pulse::find_property(source.props, "device.class") == "monitor");
	};
}

fn void real_playback_stream_names_its_app() @test
{
	@pool()
	{
		char[] payload     = $embed("../tests/fixtures/sink_inputs.bin");
		pulse::TagReader r = { .data = payload };
		skip_header(&r)!!;
		pulse::StreamRecord stream = pulse::read_sink_input(&r, 35, tmem)!!;
		assert(r.at_end());
		assert(stream.media_name == "Fixture Track");
		assert(pulse::find_property(stream.props, "application.name") == "bleu-player");
		assert(pulse::find_property(stream.props, "application.process.binary") == "fixtureplayer");
		assert(pulse::find_property(stream.props, "application.process.id") == "14149");
		assert(!stream.muted && !stream.corked);
	};
}

fn void real_record_stream_is_on_the_monitor_source() @test
{
	@pool()
	{
		char[] payload     = $embed("../tests/fixtures/source_outputs.bin");
		pulse::TagReader r = { .data = payload };
		skip_header(&r)!!;
		pulse::StreamRecord stream = pulse::read_source_output(&r, 35, tmem)!!;
		assert(r.at_end());
		assert(stream.media_name == "Voice");
		assert(pulse::find_property(stream.props, "application.name") == "bleu-recorder");
		assert(stream.has_volume && stream.volume_writable);
	};
}

// The daemon has no card, so the list reply is just its command and tag.
fn void real_empty_lists_are_empty() @test
{
	char[] payload     = $embed("../tests/fixtures/cards.bin");
	pulse::TagReader r = { .data = payload };
	skip_header(&r)!!;
	assert(r.at_end());
}

fn void synthetic_card_decodes_profiles() @test
{
	@pool()
	{
		char[] payload     = $embed("../tests/fixtures/synthetic_card.bin");
		pulse::TagReader r = { .data = payload };
		skip_header(&r)!!;
		pulse::CardRecord card = pulse::read_card(&r, 35, tmem)!!;
		assert(r.at_end());
		assert(card.name == "alsa_card.test" && card.active_profile == "a2dp-sink");
		assert(card.profiles.len == 2 && card.profiles[0].name == "a2dp-sink" && card.profiles[0].available);
		assert(card.profiles[1].name == "off");
	};
}

// The whole state from the real replies: the sink is the one output, the monitor is not an
// input, the playback stream is on the sink, and a record stream on a monitor is not a microphone.
fn void state_from_real_replies() @test
{
	@pool()
	{
		pulse::Records records;
		pulse::TagReader r;
		char[] server = $embed("../tests/fixtures/server_info.bin");
		r = { .data = server };
		skip_header(&r)!!;
		records.server = pulse::read_server_info(&r, 35)!!;
		char[] sinks = $embed("../tests/fixtures/sinks.bin");
		r = { .data = sinks };
		skip_header(&r)!!;
		records.sinks = { pulse::read_device(&r, 35, false, tmem)!! };
		char[] sources = $embed("../tests/fixtures/sources.bin");
		r = { .data = sources };
		skip_header(&r)!!;
		records.sources = { pulse::read_device(&r, 35, true, tmem)!! };
		char[] inputs = $embed("../tests/fixtures/sink_inputs.bin");
		r = { .data = inputs };
		skip_header(&r)!!;
		records.sink_inputs = { pulse::read_sink_input(&r, 35, tmem)!! };
		char[] outputs = $embed("../tests/fixtures/source_outputs.bin");
		r = { .data = outputs };
		skip_header(&r)!!;
		records.source_outputs = { pulse::read_source_output(&r, 35, tmem)!! };
		records.cards = { };
		State state = pulse::build_state(tmem, &records)!!;
		assert(state.outputs.len == 1 && state.outputs[0].id == "bleu_test" && state.outputs[0].is_default);
		assert(state.outputs[0].name == "BleuTest");
		assert(state.inputs.len == 0, "the monitor source is not an input device");
		assert(state.streams.len == 2);
		assert(state.streams[0].device_id == "bleu_test" && state.streams[0].app_name == "bleu-player");
		assert(state.streams[0].pid == 14149 && state.streams[0].binary == "fixtureplayer");
		assert(state.streams[1].flow == Flow.INPUT && state.streams[1].device_id == "bleu_test.monitor");
		assert(!state.mic_in_use, "a record stream on a monitor is not a microphone");
		assert(state.default_output == "bleu_test" && state.default_input == "bleu_test.monitor");
	};
}
// A count the packet cannot hold is refused before anything is allocated for it.
// The decoders get a 64-byte arena here: any allocation for a 4-billion-entry
// list fails it, and an allocation failure aborts the process, so the old order
// (allocate, then read) fails this test outright. The temporary pool would not
// show it, because the reads fail first. The records are written with the
// codec's own encoders, so these tests check the bounds only.
fn void hostile_port_count_is_refused() @test
{
	@pool()
	{
		DString packet;
		packet.init(tmem, 16);
		pulse::put_u32(&packet, 0xFFFFFFFF);
		pulse::TagReader r = { .data = (char[])packet.str_view() };
		char[64] storage;
		ArenaAllocator arena;
		arena.init(storage[..]);
		test::@error(pulse::read_ports(&r, 15, &arena), error::PROTOCOL);
	};
}

fn void hostile_profile_count_is_refused() @test
{
	@pool()
	{
		DString packet;
		packet.init(tmem, 32);
		pulse::put_u32(&packet, 1);
		pulse::put_string(&packet, "card");
		pulse::put_u32(&packet, pulse::NO_INDEX);
		pulse::put_string(&packet, "alsa");
		pulse::put_u32(&packet, 0xFFFFFFFF);
		pulse::TagReader r = { .data = (char[])packet.str_view() };
		char[64] storage;
		ArenaAllocator arena;
		arena.init(storage[..]);
		test::@error(pulse::read_card(&r, 35, &arena), error::PROTOCOL);
	};
}

// A count larger than the bytes that follow is refused; the same list with a count
// that fits decodes (a control for the refusal above).
fn void port_count_must_fit_the_packet() @test
{
	@pool()
	{
		DString packet;
		packet.init(tmem, 32);
		pulse::put_u32(&packet, 3);
		pulse::put_null_string(&packet);
		pulse::put_null_string(&packet);
		pulse::put_u32(&packet, 7);
		pulse::TagReader short_list = { .data = (char[])packet.str_view() };
		test::@error(pulse::read_ports(&short_list, 15, tmem), error::PROTOCOL);

		DString one;
		one.init(tmem, 32);
		pulse::put_u32(&one, 1);
		pulse::put_string(&one, "a");
		pulse::put_string(&one, "b");
		pulse::put_u32(&one, 7);
		pulse::TagReader fits = { .data = (char[])one.str_view() };
		PortRecord[] ports = pulse::read_ports(&fits, 15, tmem)!!;
		assert(fits.at_end() && ports.len == 1 && ports[0].name == "a" && ports[0].priority == 7);
	};
}
