fn void vga_identity_and_timing() @test
{
	@pool()
	{
		edid::Edid e = edid::parse(VGA[..], tmem)!!;
		test::eq(e.vendor[0], 'S');
		test::eq(e.vendor[1], 'A');
		test::eq(e.vendor[2], 'M');
		test::eq(e.vendor_code, (ushort)0x4C2D);
		test::eq(e.product_code, (ushort)596);
		test::eq(e.serial_number, (uint)1146106418);
		test::eq(e.week, (char)27);
		test::eq(e.year, (uint)2007);
		test::eq(e.version, (char)1);
		test::eq(e.revision, (char)3);
		test::eq(e.digital, false);
		test::eq(e.width_cm, (char)47);
		test::eq(e.height_cm, (char)30);
		test::eq_approx(e.gamma, 2.2, places: 6);
		test::eq(e.has_preferred_timing, true);
		test::eq(e.preferred.pixel_clock_khz, (uint)146250);
		test::eq(e.preferred.horizontal_active, (ushort)1680);
		test::eq(e.preferred.horizontal_blank, (ushort)560);
		test::eq(e.preferred.vertical_active, (ushort)1050);
		test::eq(e.preferred.vertical_blank, (ushort)39);
		test::eq(e.name, "SyncMaster");
		test::eq(e.serial_text, "HS3P701105");
		test::eq(e.extension_tags.len, (sz)0);
	};
}

fn void edp_zero_serial_and_no_descriptors() @test
{
	@pool()
	{
		edid::Edid e = edid::parse(EDP[..], tmem)!!;
		test::eq(e.vendor[0], 'S');
		test::eq(e.vendor[1], 'H');
		test::eq(e.vendor[2], 'P');
		test::eq(e.product_code, (ushort)5193);
		// Serial 0 is what the block carries, which is the zero-serial case.
		test::eq(e.serial_number, (uint)0);
		test::eq(e.year, (uint)2015);
		test::eq(e.digital, true);
		test::eq(e.preferred.pixel_clock_khz, (uint)138500);
		test::eq(e.preferred.horizontal_active, (ushort)1920);
		test::eq(e.preferred.vertical_active, (ushort)1080);
		test::eq(e.name, "");
		test::eq(e.serial_text, "");
	};
}

fn void lvds_has_no_name_or_serial() @test
{
	@pool()
	{
		edid::Edid e = edid::parse(LVDS[..], tmem)!!;
		test::eq(e.vendor[0], 'C');
		test::eq(e.vendor[1], 'M');
		test::eq(e.vendor[2], 'N');
		test::eq(e.vendor_code, (ushort)0x0DAE);
		test::eq(e.preferred.pixel_clock_khz, (uint)112600);
		test::eq(e.preferred.horizontal_blank, (ushort)366);
		test::eq(e.name, "");
	};
}

fn void dp3_extension_block_is_detected() @test
{
	@pool()
	{
		edid::Edid e = edid::parse(DP3[..], tmem)!!;
		test::eq(e.vendor[0], 'A');
		test::eq(e.vendor[1], 'C');
		test::eq(e.vendor[2], 'R');
		test::eq(e.serial_number, (uint)875572011);
		test::eq(e.name, "G236HL");
		test::eq(e.serial_text, "LVNEE0052482");
		test::eq(e.preferred.pixel_clock_khz, (uint)148500);
		test::eq(e.preferred.vertical_blank, (ushort)45);
		test::eq(e.extension_tags.len, (sz)1);
		test::eq(e.extension_tags[0], (char)0x02);
	};
}

fn void short_data_is_protocol() @test
{
	@pool()
	{
		test::@error(edid::parse(VGA[0:100], tmem), error::PROTOCOL);
	};
}

fn void wrong_header_is_protocol() @test
{
	@pool()
	{
		char[128] bad = VGA;
		bad[0] = 0x01;
		test::@error(edid::parse(bad[..], tmem), error::PROTOCOL);
	};
}

fn void base_checksum_is_protocol() @test
{
	@pool()
	{
		char[128] bad = VGA;
		bad[127] ^= 0x01;
		test::@error(edid::parse(bad[..], tmem), error::PROTOCOL);
	};
}

fn void truncated_extension_is_protocol() @test
{
	@pool()
	{
		// DP3 declares one extension block; only the base block is given.
		test::@error(edid::parse(DP3[0:128], tmem), error::PROTOCOL);
	};
}

fn void bad_extension_checksum_is_protocol() @test
{
	@pool()
	{
		char[256] bad = DP3;
		bad[255] ^= 0x01;
		test::@error(edid::parse(bad[..], tmem), error::PROTOCOL);
	};
}

fn void fingerprint_is_stable_and_separates_models() @test
{
	@pool()
	{
		edid::Edid a     = edid::parse(VGA[..], tmem)!!;
		edid::Edid again = edid::parse(VGA[..], tmem)!!;
		edid::Edid b     = edid::parse(DP3[..], tmem)!!;
		test::eq(a.fingerprint(), again.fingerprint());
		test::eq(a.fingerprint() == b.fingerprint(), false);
	};
}

// The byte that makes a 128-byte block sum to 0 mod 256.
fn char block_checksum(char[] block) @private
{
	uint total = 0;
	for (usz i = 0; i < 127; i++) total += block[i];
	return (char)((256 - (total & 0xFF)) & 0xFF);
}

fn void zero_serial_is_left_out_of_the_fingerprint() @test
{
	@pool()
	{
		// With the serial at 0, changing nothing else leaves the fingerprint as it was:
		// the serial bytes are skipped. Setting a non-zero serial changes it.
		edid::Edid zero       = edid::parse(EDP[..], tmem)!!;
		char[128] with_serial = EDP;
		with_serial[12] = 0x11;
		with_serial[127] = block_checksum(with_serial[..]);
		edid::Edid numbered = edid::parse(with_serial[..], tmem)!!;
		test::eq(numbered.serial_number != 0, true);
		test::eq(zero.fingerprint() == numbered.fingerprint(), false);
	};
}